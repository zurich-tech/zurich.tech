{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "zurich-tech",
    "main": "scripts/deployment/worker.js",
    "version_metadata": { "binding": "VERSION" },
    "compatibility_date": "2026-06-24",
    "compatibility_flags": ["nodejs_compat"],
    "routes": [
        {
            "pattern": "zurich.tech",
            "custom_domain": true,
        },
    ],
    "assets": {
        "directory": ".output/public",
        "binding": "ASSETS",
    },
    "observability": {
        "enabled": true,
    },
}
