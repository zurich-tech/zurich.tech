{
    "name": "zurich-tech",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "bun@1.3.3",
    "scripts": {
        "build": "bun run content && vinxi build",
        "check": "just check",
        "convex:codegen": "convex codegen",
        "dev": "bun run content && vinxi dev",
        "format": "prettier --write . --ignore-path .prettierignore",
        "format-check": "prettier --check . --ignore-path .prettierignore",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "content": "bun scripts/news/build.ts && prettier --write src/news/articles.generated.ts && bun scripts/branding/og.ts"
    },
    "dependencies": {
        "@convex-dev/better-auth": "0.12.5",
        "@fontsource-variable/archivo": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@solidjs/meta": "0.29.4",
        "@solidjs/router": "0.16.2",
        "@solidjs/start": "1.3.2",
        "@tailwindcss/vite": "4.3.3",
        "better-auth": "~1.6.15",
        "convex": "1.45.0",
        "maplibre-gl": "6.7.0",
        "marked": "18.0.7",
        "solid-js": "1.9.14",
        "stripe": "22.6.1",
        "tailwindcss": "4.3.3",
        "vinxi": "0.5.11",
        "vite": "8.1.5"
    },
    "devDependencies": {
        "@mapbox/vector-tile": "3.0.0",
        "@types/bun": "1.3.14",
        "@types/node": "26.1.1",
        "opentype.js": "^2.0.0",
        "pbf": "5.1.2",
        "prettier": "3.9.6",
        "sharp": "0.34.5",
        "typescript": "7.0.2",
        "wrangler": "4.112.0"
    }
}
