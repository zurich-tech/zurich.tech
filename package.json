        "tailwindcss": "4.3.1",
        "vinxi": "0.5.11",
        "vite": "8.1.0"
    },
    "devDependencies": {
        "prettier": "3.7.4",
        "typescript": "6.0.3",
        "wrangler": "4.104.0"
    }
